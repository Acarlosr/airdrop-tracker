# Nome do app (ex.: título, sidebar)
VITE_APP_NAME=ClaimOS

# URL do backend (sem barra no final). Em dev com proxy pode deixar vazio.
VITE_API_URL=http://localhost:3000

# Google Sign-In — Client ID (obrigatório para login com Google)
# Obtenha em: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# Dados fictícios só devem aparecer em ambientes explicitamente demonstrativos.
VITE_DEMO_MODE=false

# Supabase (chave anônima — pode expor no frontend; NUNCA use service_role aqui)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui
