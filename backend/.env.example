# ClaimOS Backend — variáveis de ambiente
# Copie para .env e preencha. Nunca commite .env com valores reais.

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/airdrop_db
DB_POOL_SIZE=10

# Redis (opcional, sem Redis o app funciona sem cache)
REDIS_URL=redis://localhost:6379

# Google Sign-In (validação do ID token no backend)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
JWT_SECRET=gere-uma-string-longa-aleatoria-aqui
# Opcional, recomendado para instalação pessoal/single-tenant.
ALLOWED_EMAILS=voce@exemplo.com

# Supabase (service_role apenas no backend — nunca no frontend)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# AI - Escolha um provedor:
# Opção A: Groq (recomendado, gratuito)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx
# Opção B: OpenRouter (fallback)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=z-ai/glm-4.5-air:free
# Opção C: Ollama (local)
USE_OLLAMA=false

# Blockchain
MORALIS_API_KEY=sua_moralis_key

# Social (opcional)
TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAA...
DISCORD_BOT_TOKEN=OTk5OTk5OTk5OTk5OTk5OTk5...
DISCORD_AIRDROP_CHANNEL=1234567890123456789

# Telegram (opcional)
TELEGRAM_BOT_TOKEN=seu_telegram_bot_token
TELEGRAM_CHAT_ID=seu_chat_id

# Wallets monitoradas (separadas por vírgula)
WALLET_ADDRESSES=0x...,0x...

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15m

# Logging
LOG_LEVEL=info

# AI Robot
AI_ROBOT_ENABLED=true
AI_ROBOT_SCAN_INTERVAL=30

# Frontend URL (para CORS em produção)
FRONTEND_URL=https://seu-frontend.vercel.app
