# ClaimOS Backend — variáveis de ambiente
# Copie para .env e preencha. Nunca commite .env com valores reais.

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Google Sign-In (validação do ID token no backend)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
# Opcional: JWT_EXPIRES_IN=7d
JWT_SECRET=gere-uma-string-longa-aleatoria-aqui

# Supabase (service_role apenas no backend — nunca no frontend)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# OpenRouter (nunca no frontend)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=z-ai/glm-4.5-air:free

LOG_LEVEL=info
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15m

AI_ROBOT_ENABLED=true
AI_ROBOT_SCAN_INTERVAL=30
