# Server
PORT=3000
NODE_ENV=development

# Database (Supabase free tier)
DATABASE_URL=postgresql://user:password@host:5432/airdrop_tracker
DB_POOL_SIZE=10

# Redis Cache (Upstash free tier)
REDIS_URL=redis://default:password@host:6379
CACHE_TTL_HOURS=24

# AI Services
# Ollama (local - free)
USE_OLLAMA=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenRouter (free tier - 50 req/day)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Groq (free tier - fast inference)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3-8b-8192

# Blockchain APIs
# Moralis (40k requests/month free)
MORALIS_API_KEY=...

# Alchemy (free tier - 300M compute units/month)
ALCHEMY_API_KEY=...

# Public RPCs (backup)
ETH_RPC_URL=https://ethereum.publicnode.com
ARB_RPC_URL=https://arbitrum.publicnode.com
OP_RPC_URL=https://optimism.publicnode.com
BASE_RPC_URL=https://base.publicnode.com
POLYGON_RPC_URL=https://polygon.publicnode.com

# Etherscan (5 calls/sec free)
ETHERSCAN_API_KEY=...
ARBISCAN_API_KEY=...
OPTIMISTIC_ETHERSCAN_API_KEY=...

# Social Media
# Twitter API (1500 posts/month free)
TWITTER_BEARER_TOKEN=...
TWITTER_API_KEY=...
TWITTER_API_SECRET=...

# Discord Bot (free)
DISCORD_BOT_TOKEN=...
DISCORD_GUILD_ID=...
DISCORD_CHANNEL_IDS=123456789,987654321

# Notifications
# Telegram Bot (unlimited free)
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# Discord Webhook (free)
DISCORD_WEBHOOK_URL=...

# User Configuration
# Your wallet addresses (comma separated)
WALLET_ADDRESSES=0x...,0x...

# Monitoring
# GitHub account for crypto influencers
TWITTER_ACCOUNTS=@StaniKulechov,@haydenzadams,@VitalikButerin
DISCORD_SERVERS=arbitrum,optimism,base

# Batch Processing
BATCH_SCHEDULE=0 3 * * *
BATCH_ENABLED=true

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15m

# Logging
LOG_LEVEL=info

# Auth (Google + OTP)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d
OTP_IN_DEV=true
